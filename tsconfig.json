{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    // Opciones para TypeScript de la docu de TypeORM 
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
  }
}
